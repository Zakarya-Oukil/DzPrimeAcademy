generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MODERATOR
  AMBASSADOR
  TEACHER
  STUDENT_FREE
  STUDENT_PAID
}

enum Region {
  WEST
  EAST
  CENTER
  SOUTH
}

enum InstitutionType {
  UNIVERSITY
  HIGH_SCHOOL
}

enum TrackType {
  BAC
  UNIVERSITY_LMD
  MEDICAL
}

enum ExamType {
  MIDTERM_EMD
  FINAL_SEMESTRIAL
  RATTRAPAGE
}

enum PostType {
  EVENT
  STUDY_TIP
  SESSION_SCHEDULE
  ANNOUNCEMENT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
}

enum SessionStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum SessionPlatform {
  GOOGLE_MEET
  CLASSROOM
  ONSITE
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  avatar          String?
  role            Role       @default(STUDENT_FREE)
  jobTitle        String?
  adminRole       String?
  bio             String?
  facebook        String?
  instagram       String?
  linkedin        String?
  telegram        String?
  youtube         String?
  whatsapp        String?
  website         String?
  twitter         String?
  github          String?
  phone           String?
  wilayaCode      Int?
  wilayaName      String?
  institutionId   String?
  institutionName String?
  track           TrackType?
  specialty       String?
  academicYear    String?
  studentCardId   String?    @unique
  isVerified      Boolean    @default(false)
  passwordHash    String?
  demoIndex       Int?       @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  teacherProfile       TeacherProfile?
  ambassadorProfile    AmbassadorProfile?
  subscriptions        Subscription[]
  enrollments          Enrollment[]
  sessionRegistrations SessionRegistration[]
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  activationTokens     AccountActivationToken[]
  operations           PendingOperation[]
  taughtCourses        Course[]
  taughtLiveSessions   LiveSession[]
  posts                Post[]
  postComments         PostComment[]
  postLikes            PostLike[]

  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  identifier  String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SessionRegistration {
  id           String      @id @default(cuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId    String
  student      User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName  String
  registeredAt DateTime    @default(now())
  attended     Boolean     @default(false)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Wilaya {
  code   Int    @id
  nameAr String
  nameFr String
  nameEn String
  region Region
}

model Institution {
  id         String          @id @default(cuid())
  nameAr     String
  nameFr     String
  type       InstitutionType
  wilayaCode Int
  logoUrl    String?
}

model Faculty {
  id            String @id @default(cuid())
  nameAr        String
  nameFr        String
  institutionId String
}

model Specialty {
  id        String    @id @default(cuid())
  nameAr    String
  nameFr    String
  trackType TrackType
  facultyId String
}

model AcademicYear {
  id          String  @id @default(cuid())
  nameAr      String
  nameFr      String
  semester    String?
  specialtyId String
}

model Module {
  id             String    @id @default(cuid())
  nameAr         String
  nameFr         String
  code           String
  coefficient    Int       @default(1)
  academicYearId String
  trackType      TrackType @default(UNIVERSITY_LMD)
  examsCount     Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([academicYearId])
}

model Exam {
  id                     String     @id @default(cuid())
  title                  String
  year                   Int
  termType               ExamType
  fileUrl                String
  solutionUrl            String?
  isFreeSample           Boolean    @default(false)
  downloadsCount         Int        @default(0)
  moduleId               String
  moduleName             String?
  authorName             String?
  trackType              TrackType?
  academicYearName       String?
  institutionName        String?
  previewQuestionSnippet String?
  solutionSummary        String?
  createdAt              DateTime   @default(now())

  @@index([moduleId])
}

model AmbassadorProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilayaCode            Int
  wilayaNameAr          String
  wilayaNameFr          String?
  region                Region?
  institutionId         String?
  institutionNameAr     String
  institutionNameFr     String?
  specialtyName         String?
  telegramHandle        String?
  phone                 String?
  bioAr                 String?
  bioFr                 String?
  ratingAverage         Float    @default(5.0)
  ratingsCount          Int      @default(0)
  isVerified            Boolean  @default(false)
  upcomingSessionsCount Int      @default(0)
  totalTipsShared       Int      @default(0)
  materialsCuratedCount Int      @default(0)
  studentsMentoredCount Int      @default(0)
  badges                String[]
  promoCode             String?  @unique
  referralsCount        Int      @default(0)
  commissionDzd         Int      @default(0)
  createdAt             DateTime @default(now())

  commissions CommissionEntry[]
}

model Rating {
  id           String   @id @default(cuid())
  score        Int
  comment      String?
  ambassadorId String
  studentName  String
  studentRole  Role?
  institution  String?
  createdAt    DateTime @default(now())

  @@index([ambassadorId])
}

model Post {
  id                  String    @id @default(cuid())
  title               String
  content             String
  type                PostType  @default(ANNOUNCEMENT)
  wilayaCode          Int?
  wilayaName          String?
  institutionId       String?
  institutionName     String?
  eventDate           DateTime?
  isOnline            Boolean   @default(false)
  meetUrl             String?
  location            String?
  isApproved          Boolean   @default(true)
  authorId            String
  author              User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName          String
  authorAvatar        String?
  authorRole          Role
  assignedTeacherId   String?
  assignedTeacherName String?
  videoUrl            String?
  imageUrl            String?
  linkUrl             String?
  isPrivate           Boolean   @default(false)
  createdAt           DateTime  @default(now())

  comments PostComment[]
  likes    PostLike[]

  @@index([createdAt])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id                String   @id @default(cuid())
  postId            String
  post              Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId          String
  author            User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName        String
  authorAvatar      String?
  authorRole        Role
  content           String
  isVerifiedTeacher Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([postId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String             @unique
  planName  String             @default("GOLDEN_MEMBERSHIP")
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  createdAt DateTime           @default(now())

  @@index([userId])
}

model TeacherProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  university      String
  specialty       String?
  hourlyRateDzd   Int          @default(12000)
  hoursTaught     Int          @default(0)
  studentsCount   Int          @default(0)
  ccpAccount      String?
  ccpCle          String?
  monthlyShareDzd Int          @default(0)
  payoutStatus    PayoutStatus @default(PENDING)
  lastPayoutAt    DateTime?
  createdAt       DateTime     @default(now())

  payouts FacultyPayout[]
}

model FacultyPayout {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  amountDzd        Int
  periodMonth      String
  status           PayoutStatus   @default(PENDING)
  approvedAt       DateTime?
  receiptRef       String?
  createdAt        DateTime       @default(now())

  @@index([teacherProfileId])
  @@index([status])
}

model Course {
  id           String    @id @default(cuid())
  titleAr      String
  titleFr      String?
  titleEn      String?
  description  String?
  imageUrl     String?
  teacherId    String?
  teacher      User?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherName  String
  category     TrackType @default(UNIVERSITY_LMD)
  lessonsCount Int       @default(8)
  rating       Float     @default(5.0)
  priceDzd     Int       @default(0)
  isLive       Boolean   @default(false)
  colorTheme   String    @default("lime")
  createdAt    DateTime  @default(now())

  enrollments  Enrollment[]
  liveSessions LiveSession[]

  @@index([teacherId])
}

model LiveSession {
  id              String          @id @default(cuid())
  title           String
  courseId        String?
  course          Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId       String?
  teacher         User?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  teacherName     String
  scheduledAt     DateTime
  durationMinutes Int             @default(60)
  platform        SessionPlatform @default(GOOGLE_MEET)
  meetUrl         String?
  wilayaCode      Int?
  status          SessionStatus   @default(UPCOMING)
  category        TrackType       @default(UNIVERSITY_LMD)
  createdAt       DateTime        @default(now())

  registrations SessionRegistration[]

  @@index([teacherId])
  @@index([scheduledAt])
}

model Enrollment {
  id              String   @id @default(cuid())
  studentId       String
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle     String
  teacherName     String
  progressPercent Int      @default(0)
  remainingHours  Float    @default(10)
  createdAt       DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Bundle {
  id               String    @id @default(cuid())
  titleAr          String
  titleFr          String?
  descriptionAr    String
  descriptionFr    String?
  imageUrl         String?
  track            TrackType @default(BAC)
  badge            String?
  hours            Int       @default(24)
  lecturesCount    Int       @default(3)
  originalPriceDzd Int
  currentPriceDzd  Int
  colorTheme       String    @default("gold")
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model BundlePurchase {
  id            String   @id @default(cuid())
  bundleId      String
  bundleTitleAr String
  userId        String
  userName      String
  amountDzd     Int
  paymentStatus String   @default("APPROVED_BY_ADMIN")
  operationId   String?  @unique
  createdAt     DateTime @default(now())

  @@index([userId])
}

model PlatformSettings {
  id                       String   @id @default("singleton")
  academicYear             String   @default("2025/2026")
  ambassadorCommissionRate Int      @default(10)
  baridiMobEnabled         Boolean  @default(true)
  edahabiaEnabled          Boolean  @default(true)
  ccpReceiptsEnabled       Boolean  @default(true)
  autoVerifyCards          Boolean  @default(false)
  whatsappNumber           String?  @default("https://wa.me/qr/5473INCXN3HJI1")
  telegramUsername         String?  @default("dzprime_academy")
  ambassadorTelegram       String?  @default("MrK_ADMIN00")
  linkedinUrl              String?  @default("https://www.linkedin.com/company/dzprimeacademy")
  landingConfig            Json?
  footerConfig             Json?
  vipPriceDzd              Int      @default(10000)
  updatedAt                DateTime @updatedAt
}

enum OperationType {
  ACCOUNT_ACTIVATION
  VIP_MEMBERSHIP_UPGRADE
  BUNDLE_PURCHASE
  COURSE_ENROLLMENT
  AMBASSADOR_APPLICATION
  MANUAL_SUPPORT
}

enum OperationChannel {
  WHATSAPP
  TELEGRAM
  LINKEDIN
  EMAIL_DIRECT
}

enum OperationStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingOperation {
  id              String            @id @default(cuid())
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName        String
  userEmail       String
  userPhone       String?
  userWilaya      String?
  type            OperationType     @default(ACCOUNT_ACTIVATION)
  channel         OperationChannel?
  status          OperationStatus   @default(PENDING)
  title           String
  details         String?
  amountDzd       Int               @default(0)
  promoCode       String?
  discountDzd     Int               @default(0)
  targetId        String?
  adminNotes      String?
  approvedByAdmin String?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  commission CommissionEntry?

  @@index([status, createdAt])
  @@index([userId])
}

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  descriptionAr   String
  descriptionFr   String
  isActive        Boolean   @default(true)
  type            String    @default("CAMPAIGN")
  applicableTrack String    @default("ALL")
  usageCount      Int       @default(0)
  maxUses         Int?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model CommissionEntry {
  id           String            @id @default(cuid())
  ambassadorId String
  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  operationId  String            @unique
  operation    PendingOperation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  amountDzd    Int
  ratePercent  Int
  createdAt    DateTime          @default(now())

  @@index([ambassadorId])
}

model AccountActivationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
