# Database Connections (Supabase / PostgreSQL)
# Transaction pooler URL
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"
# Direct connection URL for Prisma schema management
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication & Security
JWT_SECRET="generate_a_secure_jwt_secret_at_least_32_characters"
ADMIN_EMAIL="admin@dzprime.academy"
ADMIN_PASSWORD="change_this_to_a_strong_password"

# Public App Base URL (update in production)
NEXT_PUBLIC_APP_URL="https://dzprimeacademy.com"

# Free Email Service for Vercel (Choose Option A or Option B)
# Option A: Resend (Recommended for Vercel - Free 3,000 emails/mo, 100/day at resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxx"
EMAIL_FROM="DZ Prime Academy <onboarding@resend.dev>"

# Option B: Free Gmail SMTP (Up to 500 emails/day using any Gmail account with App Password)
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# File storage (Supabase Storage, server side only: never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
